// reyOne Construction Manager — core schema
// Single-tenant per deployment (no tenant_id). Future modules add their own
// models to this file; core models below never depend on module models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Company (singleton) — branding & global config
// ---------------------------------------------------------------------------
model Company {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String?
  phone     String?
  email     String?
  address   String?  @db.Text
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company")
}

// ---------------------------------------------------------------------------
// Users, Roles, Permissions
// ---------------------------------------------------------------------------
model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  designation  String?
  salary       Decimal?   @db.Decimal(15, 2)
  // EMPLOYEE = on staff (attendance + payroll); APP_USER = system access only
  // (owner, partner, external CA/consultant) — excluded from attendance/payroll.
  staffType    String     @default("EMPLOYEE")
  joiningDate  DateTime?  @db.Date
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id])

  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@index([roleId])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          Int              @id @default(autoincrement())
  key         String           @unique // owner, admin, project_manager, ...
  name        String
  description String?
  isSystem    Boolean          @default(false) // seeded roles cannot be deleted
  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique // "projects.create", "*" for owner
  module      String // grouping: "projects"
  action      String // "create"
  description String?
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Module registry & configuration
// ---------------------------------------------------------------------------
model Module {
  id          Int      @id @default(autoincrement())
  key         String   @unique // "projects", "finance"
  name        String
  description String?
  enabled     Boolean  @default(true)
  isCore      Boolean  @default(false) // core modules cannot be disabled
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("modules")
}

// Key/value config, grouped. value is JSON so it holds scalars, lists, objects.
model Setting {
  id        Int      @id @default(autoincrement())
  group     String // "projects", "finance", "system"
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([group, key])
  @@map("settings")
}

// Governs custom/configurable fields per entity (e.g. project form).
model FieldDefinition {
  id         Int      @id @default(autoincrement())
  entityType String // "project"
  key        String // machine key stored inside custom_fields JSON
  label      String
  fieldType  String // text, number, date, select, textarea, checkbox
  options    Json? // for select
  required   Boolean  @default(false)
  visible    Boolean  @default(true)
  isCustom   Boolean  @default(true) // false = toggling a built-in field
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, key])
  @@index([entityType])
  @@map("field_definitions")
}

// ---------------------------------------------------------------------------
// Activity log
// ---------------------------------------------------------------------------
model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // "user.created", "project.updated"
  entityType String?
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Polymorphic attachments (future File Manager plugs in here)
// ---------------------------------------------------------------------------
model Attachment {
  id           Int      @id @default(autoincrement())
  entityType   String // "project", "expense", "user"
  entityId     Int
  fileName     String
  filePath     String
  mimeType     String?
  size         Int?
  uploadedById Int?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@map("attachments")
}

// ===========================================================================
// MODULE: Projects
// Self-contained. Assignees reference users by scalar userId (no relation into
// the core User model) so this whole module can be removed without touching
// core. Phases are snapshotted onto each project at creation from the
// configurable template in settings, so editing the template never rewrites
// historical projects.
// ===========================================================================
model Project {
  id              Int       @id @default(autoincrement())
  referenceNumber String    @unique
  name            String
  // Client details (kept on the project for simplicity at this scale)
  clientName      String
  clientPhone     String?
  clientEmail     String?
  clientAddress   String?   @db.Text
  // Core project fields
  category        String?
  status          String    @default("pending")
  agreementDate   DateTime?
  // Timeline (for progress tracking & the Gantt view)
  startDate       DateTime?
  endDate         DateTime? // target completion date
  projectAmount   Decimal   @default(0) @db.Decimal(15, 2)
  advanceAmount   Decimal   @default(0) @db.Decimal(15, 2)
  // Completion % (0-100). "auto" recomputes from phase/task completion on every
  // write; "manual" lets a user pin the value and is never overwritten.
  progress        Int       @default(0)
  progressMode    String    @default("auto") // auto | manual
  // Client-specific configurable fields (governed by field_definitions)
  customFields    Json?
  createdById     Int?
  phases          ProjectPhase[]
  assignees       ProjectAssignee[]
  approvals       ProjectApproval[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([category])
  @@index([deletedAt])
  @@map("projects")
}

// Employees assigned to a whole project (used for the employee panel and
// assignment notifications). userId is a scalar FK to keep core decoupled.
model ProjectAssignee {
  projectId Int
  userId    Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_assignees")
}

model ProjectPhase {
  id        Int             @id @default(autoincrement())
  projectId Int
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  status    String          @default("pending")
  startDate DateTime?
  deadline  DateTime?
  sortOrder Int             @default(0)
  tasks     PhaseTask[]
  assignees PhaseAssignee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("project_phases")
}

// Employees assigned to a phase. userId is a scalar FK into users (no relation
// object) to keep the module decoupled from core.
model PhaseAssignee {
  phaseId Int
  userId  Int
  phase   ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@id([phaseId, userId])
  @@index([userId])
  @@map("phase_assignees")
}

model PhaseTask {
  id          Int            @id @default(autoincrement())
  phaseId     Int
  phase       ProjectPhase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title       String
  description String?        @db.Text
  status      String         @default("pending")
  deadline    DateTime?
  sortOrder   Int            @default(0)
  assignees   TaskAssignee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phaseId])
  @@map("phase_tasks")
}

model TaskAssignee {
  taskId Int
  userId Int
  task   PhaseTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

// Lightweight approval/request workflow on a project (phase sign-off, budget
// approval, material/finance request, or a general ask). Raised by site staff,
// decided by a user holding `projects.approve`. Decoupled scalar links only.
model ProjectApproval {
  id            Int       @id @default(autoincrement())
  projectId     Int
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId       Int? // optional link to the phase this is about
  type          String    @default("general") // phase_completion | budget | material | general
  title         String
  description   String?   @db.Text
  amount        Decimal?  @db.Decimal(15, 2) // optional (budget/finance requests)
  priority      String    @default("normal") // low | normal | high | urgent
  status        String    @default("pending") // pending | approved | rejected
  requestedById Int
  decidedById   Int?
  decidedAt     DateTime?
  decisionNote  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("project_approvals")
}

// ===========================================================================
// MODULE: Documents
// A document generated from a template in the library. The template bodies live
// in code (document template catalog); only the filled values + metadata are
// stored here. Rendering merges template + values + company branding on demand.
// ===========================================================================
model GeneratedDocument {
  id          Int      @id @default(autoincrement())
  templateKey String
  title       String
  category    String?
  projectId   Int? // optional scalar links (decoupled)
  clientId    Int?
  reference   String? // e.g. document number / ref
  data        Json     @default("{}") // filled field values
  status      String   @default("final") // draft | final
  createdById Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([templateKey])
  @@index([projectId])
  @@index([deletedAt])
  @@map("generated_documents")
}

// ===========================================================================
// MODULE: Invoices & Quotations
// Retired from the product UI (superseded by the Documents module). Model kept
// so existing records are preserved rather than dropped.
// One table serves both document types. Items are stored as JSON; totals are
// computed server-side. projectId is a scalar link to keep it decoupled.
// ===========================================================================
enum BillingType {
  QUOTATION
  INVOICE
}

model BillingDocument {
  id            Int         @id @default(autoincrement())
  type          BillingType
  template      String      @default("standard") // standard | gst
  gstSplit      Boolean     @default(false) // GST template: split into CGST + SGST
  number        String
  projectId     Int?
  clientName    String
  clientPhone   String?
  clientEmail   String?
  clientAddress String?     @db.Text
  issueDate     DateTime
  dueDate       DateTime?
  items         Json // [{ description, quantity, unitPrice, total }]
  subtotal      Decimal     @db.Decimal(15, 2)
  taxRate       Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal     @default(0) @db.Decimal(15, 2)
  total         Decimal     @db.Decimal(15, 2)
  status        String      @default("draft")
  notes         String?     @db.Text
  terms         String?     @db.Text
  createdById   Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([type, number])
  @@index([type])
  @@index([deletedAt])
  @@map("billing_documents")
}

// ===========================================================================
// MODULE: Notifications
// Per-user, in-app notifications. Recipients are referenced by scalar userId.
// ===========================================================================
model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int // recipient
  type       String // project.assigned, project.status, payment.received, ...
  title      String
  message    String?   @db.Text
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ===========================================================================
// MODULE: Finance
// Payments (money in, always project-tied) and Expenses (money out, project or
// company). Accounts, payment methods, and expense categories are configured
// in settings; transactions reference them by key. projectId/phaseId are
// scalar FKs (no relation into the Projects module) to keep finance removable
// independently. Account balances are always DERIVED from these rows, never
// stored, so they can't drift.
// ===========================================================================
model Payment {
  id          Int      @id @default(autoincrement())
  projectId   Int
  phaseId     Int?
  amount      Decimal  @db.Decimal(15, 2)
  date        DateTime
  method      String // payment method key (settings: finance.payment_methods)
  account     String // account key (settings: finance.accounts)
  notes       String?  @db.Text
  createdById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([account])
  @@index([date])
  @@map("payments")
}

enum ExpenseScope {
  PROJECT
  COMPANY
}

model Expense {
  id          Int          @id @default(autoincrement())
  scope       ExpenseScope @default(COMPANY)
  projectId   Int? // required when scope = PROJECT
  category    String
  amount      Decimal      @db.Decimal(15, 2)
  date        DateTime
  method        String
  account       String
  expenseBy     String?
  paidTo        String? // legacy free-text; superseded by vendorId
  vendorId      Int?
  workforceId   Int? // payee when it's a workforce member
  paymentStatus String   @default("PAID") // PAID | PARTIAL | CREDIT
  amountPaid    Decimal  @default(0) @db.Decimal(15, 2) // total settled (at entry + later vendor payments)
  billNumber    String? // supplier's bill / invoice no.
  dueDate       DateTime? // when the unpaid balance is due
  purchaseOrderId Int?
  notes         String?  @db.Text
  createdById   Int?
  allocations   VendorPaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@index([projectId])
  @@index([account])
  @@index([category])
  @@index([date])
  @@index([vendorId])
  @@index([workforceId])
  @@map("expenses")
}

// ===========================================================================
// MODULE: Workforce
// People involved in project execution (contractor, labour, technician, …).
// Categories are configurable via settings.
// ===========================================================================
enum WorkforceStatus {
  ACTIVE
  INACTIVE
}

model Workforce {
  id        Int             @id @default(autoincrement())
  name      String
  category  String
  workerType String         @default("LABOUR") // LABOUR | CONTRACTOR
  firmName  String? // contractor's company / team name
  siteProjectId Int? // site currently working at (default for attendance)
  joiningDate DateTime?     @db.Date
  phone     String?
  address   String?         @db.Text
  notes     String?         @db.Text
  status    WorkforceStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([status])
  @@index([deletedAt])
  @@map("workforce")
}

// ===========================================================================
// MODULE: Project Requirements & Details
// Requirements come in independently-toggleable kinds (text, custom form,
// table). content is a flexible JSON payload per kind. Photos are separate.
// ===========================================================================
model ProjectRequirement {
  id        Int      @id @default(autoincrement())
  projectId Int
  kind      String // TEXT | FORM | TABLE
  title     String?
  content   Json // TEXT: { text }; FORM: { fields, values }; TABLE: { columns, rows }
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, kind])
  @@map("project_requirements")
}

// Records for the fully-configurable Custom Module. The form schema lives in
// the settings table (group "custom_module"); each record's values are JSON
// keyed by field id.
model CustomRecord {
  id        Int       @id @default(autoincrement())
  values    Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("custom_records")
}

model ProjectPhoto {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String?
  mimeType  String?
  category  String? // configurable photo/document category
  data      String   @db.LongText // base64 data URL
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_photos")
}

// ===========================================================================
// MODULE: Vendors
// ===========================================================================
model Vendor {
  id            Int       @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  gstNumber     String?
  address       String?   @db.Text
  notes         String?   @db.Text
  rating        Int? // 1-5 vendor rating
  ratingNote    String?   @db.Text
  creditDays    Int       @default(0) // default payment terms for new bills
  category      String? // e.g. Cement supplier, Steel, Hardware, Transport
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([deletedAt])
  @@map("vendors")
}

// ===========================================================================
// MODULE: Clients
// Auto-populated from projects (upserted by name) and enriched here.
// ===========================================================================
model Client {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?   @db.Text
  gstNumber     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@map("clients")
}

// ===========================================================================
// SHARED: stored files (bills, receipts, photos, attachments). Base64 data URL
// kept in the DB — fine at this scale; swap for object storage later without
// changing callers (they only see id/name/mimeType/data).
// ===========================================================================
model StoredFile {
  id           Int      @id @default(autoincrement())
  entityType   String // vendor_bill | expense | query | query_reply | inspection | client
  entityId     Int
  name         String?
  mimeType     String?
  size         Int?
  data         String   @db.LongText
  caption      String?
  takenAt      DateTime? // original capture time (from photo EXIF) when known
  uploadedById Int?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@map("stored_files")
}

// ===========================================================================
// MODULE: Attendance & Payroll
// A "person" is either a system user (employee) or a workforce member
// (labour / contractor): personType = USER | WORKFORCE, personId = its id.
// ===========================================================================
model SalaryProfile {
  id            Int      @id @default(autoincrement())
  personType    String // USER | WORKFORCE
  personId      Int
  payType       String   @default("monthly") // monthly | daily
  rate          Decimal  @db.Decimal(15, 2) // monthly salary or daily wage
  effectiveFrom DateTime?
  notes         String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([personType, personId])
  @@map("salary_profiles")
}

model AttendanceRecord {
  id          Int      @id @default(autoincrement())
  personType  String
  personId    Int
  date        DateTime @db.Date
  status      String // present | absent | half_day | leave
  projectId   Int?
  checkIn     String? // HH:MM
  checkOut    String?
  notes       String?
  markedById  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([personType, personId, date])
  @@index([date])
  @@index([projectId])
  @@map("attendance_records")
}

model SalaryAdvance {
  id          Int      @id @default(autoincrement())
  personType  String
  personId    Int
  amount      Decimal  @db.Decimal(15, 2)
  date        DateTime
  method      String?
  notes       String?  @db.Text
  expenseId   Int? // mirrored Finance expense
  createdById Int?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  @@index([personType, personId])
  @@map("salary_advances")
}

model SalaryPayment {
  id               Int      @id @default(autoincrement())
  personType       String
  personId         Int
  period           String // YYYY-MM the payment settles
  grossAmount      Decimal  @db.Decimal(15, 2) // salary amount being settled
  advanceDeduction Decimal  @default(0) @db.Decimal(15, 2)
  otherDeduction   Decimal  @default(0) @db.Decimal(15, 2)
  bonus            Decimal  @default(0) @db.Decimal(15, 2)
  netPaid          Decimal  @db.Decimal(15, 2)
  date             DateTime
  method           String?
  notes            String?  @db.Text
  expenseId        Int? // mirrored Finance expense
  createdById      Int?
  createdAt        DateTime @default(now())
  deletedAt        DateTime?

  @@index([personType, personId])
  @@index([period])
  @@map("salary_payments")
}

// ===========================================================================
// MODULE: Materials & Inventory
// Stock lives at a location: projectId = null is the central store, otherwise
// a project site. Balance = sum of signed movement quantities.
// ===========================================================================
model Material {
  id           Int      @id @default(autoincrement())
  name         String
  unit         String   @default("nos")
  category     String?
  reorderLevel Decimal  @default(0) @db.Decimal(15, 3)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([deletedAt])
  @@map("materials")
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  materialId  Int
  projectId   Int? // location; null = central store
  type        String // PURCHASE | TRANSFER_IN | TRANSFER_OUT | CONSUME | ADJUST | RETURN
  quantity    Decimal  @db.Decimal(15, 3) // signed: + into location, - out
  rate        Decimal? @db.Decimal(15, 2)
  vendorId    Int?
  requestId   Int?
  date        DateTime
  notes       String?  @db.Text
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([materialId, projectId])
  @@index([vendorId])
  @@index([date])
  @@map("stock_movements")
}

model MaterialRequest {
  id            Int       @id @default(autoincrement())
  projectId     Int
  requestedById Int
  status        String    @default("pending") // pending | approved | rejected | fulfilled
  priority      String    @default("normal")
  neededBy      DateTime?
  notes         String?   @db.Text
  items         Json // [{ materialId, name, unit, quantity, approvedQty }]
  decidedById   Int?
  decidedAt     DateTime?
  decisionNote  String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("material_requests")
}

// ===========================================================================
// MODULE: Site Inspection
// ===========================================================================
model Inspection {
  id          Int      @id @default(autoincrement())
  projectId   Int
  title       String
  date        DateTime
  inspectorId Int?
  // assigned (waiting for inspector) | in_progress | completed (submitted) | closed
  // Legacy "open" rows are treated as in_progress.
  status      String   @default("assigned")
  checklist   Json // [{ item, result: pass|fail|na, remark }]
  remarks     String?  @db.Text
  instructions String? @db.Text // what the inspector must check / focus on
  dueDate     DateTime?
  completedAt DateTime?
  completedById Int?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  issues      InspectionIssue[]

  @@index([projectId])
  @@index([status])
  @@map("inspections")
}

model InspectionIssue {
  id               Int        @id @default(autoincrement())
  inspectionId     Int
  inspection       Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  description      String     @db.Text
  severity         String     @default("medium") // low | medium | high | critical
  assignedToId     Int?
  correctiveAction String?    @db.Text
  dueDate          DateTime?
  status           String     @default("open") // open | in_progress | resolved | verified
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([inspectionId])
  @@index([assignedToId])
  @@map("inspection_issues")
}

// ===========================================================================
// MODULE: Queries
// ===========================================================================
model Query {
  id          Int      @id @default(autoincrement())
  number      String? // Q-0001
  type        String   @default("rfi") // rfi | clarification | site_issue | design_change | approval | general
  category    String?
  projectId   Int?
  phaseId     Int? // the stage/phase the query relates to
  location    String? // block / floor / grid / room
  workItem    String? // activity or BOQ item
  title       String
  description String?  @db.Text
  priority    String   @default("normal") // low | normal | high | urgent
  // open → assigned → (awaiting_response ↔ responded) → resolved → closed
  status      String   @default("open")
  visibility  String   @default("assigned") // assigned | all
  assigneeIds Json     @default("[]")
  mentionIds  Json     @default("[]") // tagged people (kept informed)
  dueDate     DateTime?
  costImpact     Boolean @default(false)
  scheduleImpact Boolean @default(false)
  resolution  String?  @db.Text
  resolvedById Int?
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  replies     QueryReply[]

  @@index([projectId])
  @@index([status])
  @@map("queries")
}

model QueryReply {
  id        Int      @id @default(autoincrement())
  queryId   Int
  query     Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
  userId    Int
  kind      String   @default("reply") // reply | response | event
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([queryId])
  @@map("query_replies")
}

// ===========================================================================
// Clients depth: communication log + payment schedule (installments)
// ===========================================================================
model ClientNote {
  id          Int      @id @default(autoincrement())
  clientId    Int
  type        String   @default("note") // note | call | meeting | email | site_visit
  note        String   @db.Text
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@map("client_notes")
}

model PaymentSchedule {
  id        Int      @id @default(autoincrement())
  projectId Int
  title     String
  dueDate   DateTime
  amount    Decimal  @db.Decimal(15, 2)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("payment_schedules")
}

// ===========================================================================
// MOBILE: push notification device tokens (Firebase Cloud Messaging)
// ===========================================================================
model DeviceToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  token      String   @unique @db.VarChar(512)
  platform   String   @default("android") // android | ios
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("device_tokens")
}

// ===========================================================================
// PROCUREMENT: purchase orders, goods receipts and vendor payables.
// Workflow: (site request →) PO to vendor → goods received note (stock in +
// vendor bill) → vendor payments settle bills; unallocated payment = advance.
// ===========================================================================
model PurchaseOrder {
  id           Int       @id @default(autoincrement())
  number       String    @unique // PO-0001
  vendorId     Int
  projectId    Int? // deliver to site; null = central store
  requestId    Int? // raised from a material request
  status       String    @default("draft") // draft | ordered | partially_received | received | cancelled
  orderDate    DateTime
  expectedDate DateTime?
  items        Json // [{ materialId, name, unit, quantity, rate, receivedQty }]
  taxPercent   Decimal   @default(0) @db.Decimal(5, 2)
  notes        String?   @db.Text
  terms        String?   @db.Text
  createdById  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([vendorId])
  @@index([status])
  @@map("purchase_orders")
}

model GoodsReceipt {
  id              Int      @id @default(autoincrement())
  number          String   @unique // GRN-0001
  purchaseOrderId Int?
  vendorId        Int?
  projectId       Int? // received at site; null = central store
  date            DateTime
  items           Json // [{ materialId, name, unit, quantity, rate }]
  billNumber      String?
  amount          Decimal  @default(0) @db.Decimal(15, 2)
  expenseId       Int? // the vendor bill created for this receipt
  notes           String?  @db.Text
  createdById     Int?
  createdAt       DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([vendorId])
  @@map("goods_receipts")
}

model VendorPayment {
  id          Int       @id @default(autoincrement())
  vendorId    Int
  date        DateTime
  amount      Decimal   @db.Decimal(15, 2)
  method      String
  account     String
  reference   String? // cheque / UTR no.
  notes       String?   @db.Text
  createdById Int?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  allocations VendorPaymentAllocation[]

  @@index([vendorId])
  @@map("vendor_payments")
}

model VendorPaymentAllocation {
  id        Int           @id @default(autoincrement())
  paymentId Int
  payment   VendorPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  expenseId Int
  expense   Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(15, 2)
  createdAt DateTime      @default(now())

  @@index([paymentId])
  @@index([expenseId])
  @@map("vendor_payment_allocations")
}
