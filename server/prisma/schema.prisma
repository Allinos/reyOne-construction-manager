// reyOne Construction Manager — core schema
// Single-tenant per deployment (no tenant_id). Future modules add their own
// models to this file; core models below never depend on module models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Company (singleton) — branding & global config
// ---------------------------------------------------------------------------
model Company {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String?
  phone     String?
  email     String?
  address   String?  @db.Text
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company")
}

// ---------------------------------------------------------------------------
// Users, Roles, Permissions
// ---------------------------------------------------------------------------
model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  designation  String?
  salary       Decimal?   @db.Decimal(15, 2)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id])

  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@index([roleId])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          Int              @id @default(autoincrement())
  key         String           @unique // owner, admin, project_manager, ...
  name        String
  description String?
  isSystem    Boolean          @default(false) // seeded roles cannot be deleted
  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique // "projects.create", "*" for owner
  module      String // grouping: "projects"
  action      String // "create"
  description String?
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Module registry & configuration
// ---------------------------------------------------------------------------
model Module {
  id          Int      @id @default(autoincrement())
  key         String   @unique // "projects", "finance"
  name        String
  description String?
  enabled     Boolean  @default(true)
  isCore      Boolean  @default(false) // core modules cannot be disabled
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("modules")
}

// Key/value config, grouped. value is JSON so it holds scalars, lists, objects.
model Setting {
  id        Int      @id @default(autoincrement())
  group     String // "projects", "finance", "system"
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([group, key])
  @@map("settings")
}

// Governs custom/configurable fields per entity (e.g. project form).
model FieldDefinition {
  id         Int      @id @default(autoincrement())
  entityType String // "project"
  key        String // machine key stored inside custom_fields JSON
  label      String
  fieldType  String // text, number, date, select, textarea, checkbox
  options    Json? // for select
  required   Boolean  @default(false)
  visible    Boolean  @default(true)
  isCustom   Boolean  @default(true) // false = toggling a built-in field
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, key])
  @@index([entityType])
  @@map("field_definitions")
}

// ---------------------------------------------------------------------------
// Activity log
// ---------------------------------------------------------------------------
model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // "user.created", "project.updated"
  entityType String?
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Polymorphic attachments (future File Manager plugs in here)
// ---------------------------------------------------------------------------
model Attachment {
  id           Int      @id @default(autoincrement())
  entityType   String // "project", "expense", "user"
  entityId     Int
  fileName     String
  filePath     String
  mimeType     String?
  size         Int?
  uploadedById Int?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@map("attachments")
}

// ===========================================================================
// MODULE: Projects
// Self-contained. Assignees reference users by scalar userId (no relation into
// the core User model) so this whole module can be removed without touching
// core. Phases are snapshotted onto each project at creation from the
// configurable template in settings, so editing the template never rewrites
// historical projects.
// ===========================================================================
model Project {
  id              Int       @id @default(autoincrement())
  referenceNumber String    @unique
  name            String
  // Client details (kept on the project for simplicity at this scale)
  clientName      String
  clientPhone     String?
  clientEmail     String?
  clientAddress   String?   @db.Text
  // Core project fields
  category        String?
  status          String    @default("pending")
  agreementDate   DateTime?
  projectAmount   Decimal   @default(0) @db.Decimal(15, 2)
  advanceAmount   Decimal   @default(0) @db.Decimal(15, 2)
  // Client-specific configurable fields (governed by field_definitions)
  customFields    Json?
  createdById     Int?
  phases          ProjectPhase[]
  assignees       ProjectAssignee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([category])
  @@index([deletedAt])
  @@map("projects")
}

// Employees assigned to a whole project (used for the employee panel and
// assignment notifications). userId is a scalar FK to keep core decoupled.
model ProjectAssignee {
  projectId Int
  userId    Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_assignees")
}

model ProjectPhase {
  id        Int             @id @default(autoincrement())
  projectId Int
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  status    String          @default("pending")
  deadline  DateTime?
  sortOrder Int             @default(0)
  tasks     PhaseTask[]
  assignees PhaseAssignee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("project_phases")
}

// Employees assigned to a phase. userId is a scalar FK into users (no relation
// object) to keep the module decoupled from core.
model PhaseAssignee {
  phaseId Int
  userId  Int
  phase   ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@id([phaseId, userId])
  @@index([userId])
  @@map("phase_assignees")
}

model PhaseTask {
  id          Int            @id @default(autoincrement())
  phaseId     Int
  phase       ProjectPhase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title       String
  description String?        @db.Text
  status      String         @default("pending")
  deadline    DateTime?
  sortOrder   Int            @default(0)
  assignees   TaskAssignee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phaseId])
  @@map("phase_tasks")
}

model TaskAssignee {
  taskId Int
  userId Int
  task   PhaseTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

// ===========================================================================
// MODULE: Invoices & Quotations
// One table serves both document types. Items are stored as JSON; totals are
// computed server-side. projectId is a scalar link to keep it decoupled.
// ===========================================================================
enum BillingType {
  QUOTATION
  INVOICE
}

model BillingDocument {
  id            Int         @id @default(autoincrement())
  type          BillingType
  template      String      @default("standard") // standard | gst
  gstSplit      Boolean     @default(false) // GST template: split into CGST + SGST
  number        String
  projectId     Int?
  clientName    String
  clientPhone   String?
  clientEmail   String?
  clientAddress String?     @db.Text
  issueDate     DateTime
  dueDate       DateTime?
  items         Json // [{ description, quantity, unitPrice, total }]
  subtotal      Decimal     @db.Decimal(15, 2)
  taxRate       Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal     @default(0) @db.Decimal(15, 2)
  total         Decimal     @db.Decimal(15, 2)
  status        String      @default("draft")
  notes         String?     @db.Text
  terms         String?     @db.Text
  createdById   Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([type, number])
  @@index([type])
  @@index([deletedAt])
  @@map("billing_documents")
}

// ===========================================================================
// MODULE: Notifications
// Per-user, in-app notifications. Recipients are referenced by scalar userId.
// ===========================================================================
model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int // recipient
  type       String // project.assigned, project.status, payment.received, ...
  title      String
  message    String?   @db.Text
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ===========================================================================
// MODULE: Finance
// Payments (money in, always project-tied) and Expenses (money out, project or
// company). Accounts, payment methods, and expense categories are configured
// in settings; transactions reference them by key. projectId/phaseId are
// scalar FKs (no relation into the Projects module) to keep finance removable
// independently. Account balances are always DERIVED from these rows, never
// stored, so they can't drift.
// ===========================================================================
model Payment {
  id          Int      @id @default(autoincrement())
  projectId   Int
  phaseId     Int?
  amount      Decimal  @db.Decimal(15, 2)
  date        DateTime
  method      String // payment method key (settings: finance.payment_methods)
  account     String // account key (settings: finance.accounts)
  notes       String?  @db.Text
  createdById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([account])
  @@index([date])
  @@map("payments")
}

enum ExpenseScope {
  PROJECT
  COMPANY
}

model Expense {
  id          Int          @id @default(autoincrement())
  scope       ExpenseScope @default(COMPANY)
  projectId   Int? // required when scope = PROJECT
  category    String
  amount      Decimal      @db.Decimal(15, 2)
  date        DateTime
  method        String
  account       String
  expenseBy     String?
  paidTo        String? // legacy free-text; superseded by vendorId
  vendorId      Int?
  workforceId   Int? // payee when it's a workforce member
  paymentStatus String   @default("PAID") // PAID | PARTIAL | CREDIT
  amountPaid    Decimal  @default(0) @db.Decimal(15, 2)
  notes         String?  @db.Text
  createdById   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@index([projectId])
  @@index([account])
  @@index([category])
  @@index([date])
  @@index([vendorId])
  @@index([workforceId])
  @@map("expenses")
}

// ===========================================================================
// MODULE: Workforce
// People involved in project execution (contractor, labour, technician, …).
// Categories are configurable via settings.
// ===========================================================================
enum WorkforceStatus {
  ACTIVE
  INACTIVE
}

model Workforce {
  id        Int             @id @default(autoincrement())
  name      String
  category  String
  phone     String?
  address   String?         @db.Text
  notes     String?         @db.Text
  status    WorkforceStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([status])
  @@index([deletedAt])
  @@map("workforce")
}

// ===========================================================================
// MODULE: Project Requirements & Details
// Requirements come in independently-toggleable kinds (text, custom form,
// table). content is a flexible JSON payload per kind. Photos are separate.
// ===========================================================================
model ProjectRequirement {
  id        Int      @id @default(autoincrement())
  projectId Int
  kind      String // TEXT | FORM | TABLE
  title     String?
  content   Json // TEXT: { text }; FORM: { fields, values }; TABLE: { columns, rows }
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, kind])
  @@map("project_requirements")
}

// Records for the fully-configurable Custom Module. The form schema lives in
// the settings table (group "custom_module"); each record's values are JSON
// keyed by field id.
model CustomRecord {
  id        Int       @id @default(autoincrement())
  values    Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("custom_records")
}

model ProjectPhoto {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String?
  mimeType  String?
  category  String? // configurable photo/document category
  data      String   @db.LongText // base64 data URL
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_photos")
}

// ===========================================================================
// MODULE: Vendors
// ===========================================================================
model Vendor {
  id            Int       @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  gstNumber     String?
  address       String?   @db.Text
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([deletedAt])
  @@map("vendors")
}

// ===========================================================================
// MODULE: Clients
// Auto-populated from projects (upserted by name) and enriched here.
// ===========================================================================
model Client {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?   @db.Text
  gstNumber     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@map("clients")
}
